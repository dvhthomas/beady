{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ has no initialised .beads folder. Choose a project that uses beads, or its .beads folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keinen initialisierten .beads-Ordner. Wähle ein Projekt, das beads verwendet, oder dessen .beads-Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene una carpeta .beads inicializada. Elige un proyecto que use beads, o su carpeta .beads."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas de dossier .beads initialisé. Choisissez un projet qui utilise beads, ou son dossier .beads."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には初期化された.beadsフォルダがありません。beadsを使っているプロジェクトか、その.beadsフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 초기화된 .beads 폴더가 없습니다. beads를 사용하는 프로젝트나 그 .beads 폴더를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não tem uma pasta .beads inicializada. Escolha um projeto que use o beads, ou a pasta .beads dele."
          }
        }
      }
    },
    "Couldn't find the bd executable. Looked in: %@. Set BD_PATH to override." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Programm bd wurde nicht gefunden. Gesucht in: %@. Setze BD_PATH, um den Pfad vorzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el ejecutable de bd. Se buscó en: %@. Define BD_PATH para indicar otra ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver l'exécutable bd. Recherché dans : %@. Définissez BD_PATH pour imposer un chemin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bdの実行ファイルが見つかりませんでした。探した場所：%@。BD_PATHを設定すると上書きできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bd 실행 파일을 찾을 수 없습니다. 찾아본 위치: %@. 다른 경로를 쓰려면 BD_PATH를 설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar o executável do bd. Procurado em: %@. Defina BD_PATH para indicar outro caminho."
          }
        }
      }
    },
