          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La categoría frozen de bd: apartado a propósito, que es deferred y pinned a menos que esta base de datos añada los suyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
