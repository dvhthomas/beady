    },
    "bd's frozen category: deliberately set aside, which is deferred and pinned unless this database adds its own." : {
      "comment" : "Hover help; keep bd's words frozen, deferred and pinned as they are",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
