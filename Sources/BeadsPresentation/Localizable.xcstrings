        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bd의 active 범주: 작업 가능한 상태로, 이 데이터베이스가 자체 상태를 추가하지 않는 한 open 상태입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
