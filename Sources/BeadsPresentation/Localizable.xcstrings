        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はビーズ用に設定されていますが、このコピーにはまだデータベースがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 비즈용으로 설정되어 있지만 이 사본에는 아직 데이터베이스가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está configurado para beads, e esta cópia ainda não tem o banco de dados."
          }
        }
      }
    },
