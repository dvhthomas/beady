    "No database server to run: bd reads and writes these files itself, one program at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Datenbankserver nötig: bd liest und schreibt diese Dateien selbst, immer nur ein Programm zur selben Zeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay que ejecutar ningún servidor de base de datos: bd lee y escribe estos archivos directamente, un programa a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun serveur de base de données à lancer : bd lit et écrit ces fichiers lui-même, un programme à la fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースサーバーは不要です。bdがこれらのファイルを直接読み書きし、一度に書き込めるプログラムは1つです。"
