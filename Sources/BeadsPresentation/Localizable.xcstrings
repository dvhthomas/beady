        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado por uma dependência como status armazenado, na categoria wip; a visualização Aguardando e o filtro Bloqueado usam o grafo de dependências, então um bead pode estar bloqueado sem ele."
          }
        }
      }
