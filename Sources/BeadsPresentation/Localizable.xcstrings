    "bd's lifecycle category for the bead's status: active, wip, frozen or done." : {
      "comment" : "Hover help for a filter field",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lebenszyklus-Kategorie von bd für den Status des Beads: active, wip, frozen oder done."
          }
        },
        "es" : {
