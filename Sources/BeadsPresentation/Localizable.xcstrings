            "value" : "This view was saved by a newer Beady (format %1$lld); this Beady reads format %2$lld. Update Beady to open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta vista la guardó un Beady más reciente (formato %1$lld); este Beady lee el formato %2$lld. Actualiza Beady para abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
