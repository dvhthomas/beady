    "This view was saved by a newer Beady (format %lld); this Beady reads format %lld. Update Beady to open it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ansicht wurde von einem neueren Beady gesichert (Format %1$lld); dieses Beady liest Format %2$lld. Aktualisiere Beady, um sie zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
