            "value" : "Beads de la categoría wip de bd: in_progress, blocked y hooked, más cualquier estado personalizado clasificado como wip."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beads de la catégorie wip de bd : in_progress, blocked et hooked, plus tout statut personnalisé classé sous wip."
          }
        },
        "ja" : {
          "stringUnit" : {
