    "%@ uses beads, and this copy doesn't have the database yet. bd found it on the repository's remote and can fetch it. Nothing here is replaced." : {
      "comment" : "Alert text; the folder's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet Beads, und diese Kopie hat die Datenbank noch nicht. bd hat sie auf dem Remote des Repositorys gefunden und kann sie holen. Hier wird nichts ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa beads, y esta copia todavía no tiene la base de datos. bd la encontró en el remoto del repositorio y puede traerla. Aquí no se reemplaza nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilise beads, et cette copie n'a pas encore la base de données. bd l'a trouvée sur le dépôt distant et peut la récupérer. Rien n'est remplacé ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はビーズを使用していますが、このコピーにはまだデータベースがありません。bdがリポジトリのリモートで見つけたので、取得できます。ここにあるものは何も置き換えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 비즈를 사용하지만 이 사본에는 아직 데이터베이스가 없습니다. bd가 저장소의 리모트에서 찾았으며 가져올 수 있습니다. 여기 있는 것은 아무것도 대치되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa beads, e esta cópia ainda não tem o banco de dados. O bd o encontrou no remoto do repositório e pode buscá-lo. Nada aqui é substituído."
          }
        }
      }
    },
