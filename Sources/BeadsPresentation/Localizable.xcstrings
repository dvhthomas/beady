{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nbd says: %@\n\nbd will run:\n%@" : {
      "comment" : "Alert text: an explanation, then bd's own reason, then the exact command line",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nbd meldet: %2$@\n\nbd führt aus:\n%3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\n\nbd says: %2$@\n\nbd will run:\n%3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nbd dice: %2$@\n\nbd ejecutará:\n%3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nbd indique : %2$@\n\nbd exécutera :\n%3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nbdからの説明：%2$@\n\nbdが実行するコマンド：\n%3$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nbd의 설명: %2$@\n\nbd가 실행할 명령:\n%3$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nO bd diz: %2$@\n\nO bd vai executar:\n%3$@"
          }
        }
      }
    },
    "%@ (imported)" : {
      "comment" : "Name of an imported view whose id was already taken",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (importiert)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (importada)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (importée)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（読み込み）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (가져옴)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (importada)"
          }
        }
      }
    },
    "%@ changed %@ %@. Refresh if you're not sure you're looking at the latest." : {
      "comment" : "Warning: who changed what, and a relative time such as ‘2 minutes ago’",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat %2$@ %3$@ geändert. Aktualisiere, wenn du nicht sicher bist, ob du den neuesten Stand siehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ changed %2$@ %3$@. Refresh if you're not sure you're looking at the latest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cambió %2$@ %3$@. Actualiza si no tienes claro que estás viendo lo más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a modifié %2$@ %3$@. Actualisez si vous n'êtes pas sûr de voir la dernière version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@に%1$@が%2$@を変更しました。最新の状態か不明な場合は更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 님이 %3$@ %2$@ 항목을 변경했습니다. 최신 상태인지 확실하지 않다면 새로 고침하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ alterou %2$@ %3$@. Atualize se não tiver certeza de que está vendo a versão mais recente."
          }
        }
      }
    },
    "%@ copy" : {
      "comment" : "Name of a duplicated view",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kopie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia de %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ copie"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のコピー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 복사본"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cópia"
          }
        }
      }
    },
    "%@ has no .beads database, and it isn't a git repository (no .git inside it), so Beady won't create one there. Run git init in it first, or choose a repository." : {
      "comment" : "The folder's path",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keine .beads-Datenbank und ist kein Git-Repository (kein .git darin), daher legt Beady dort keine an. Führe zuerst git init darin aus oder wähle ein Repository."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene base de datos .beads y no es un repositorio Git (no hay .git dentro), así que Beady no creará una ahí. Ejecuta primero git init en ella o elige un repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas de base de données .beads et n'est pas un dépôt Git (pas de .git à l'intérieur), Beady n'en créera donc pas ici. Exécutez d'abord git init dans ce dossier, ou choisissez un dépôt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ には .beads データベースがなく、Git リポジトリでもありません（中に .git がありません）。そのため Beady はそこには作成しません。先にそのフォルダで git init を実行するか、リポジトリを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 .beads 데이터베이스가 없고 Git 저장소도 아닙니다(안에 .git이 없음). 따라서 Beady는 거기에 데이터베이스를 만들지 않습니다. 먼저 해당 폴더에서 git init을 실행하거나 저장소를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não tem um banco de dados .beads e não é um repositório Git (não há .git dentro), então o Beady não criará um ali. Execute git init nela primeiro ou escolha um repositório."
          }
        }
      }
    },
    "%@ is a git repository without a .beads database. Beady can make one: bd's embedded Dolt storage, beads named %@-<id>, no agent files and no git hooks.\n\nbd will run:\n%@\n\nbd commits the new .beads folder and a .gitignore entry to the repository, and touches nothing else." : {
      "comment" : "Alert text; the folder's name, the issue-id prefix, then the exact command line",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Git-Repository ohne .beads-Datenbank. Beady kann eine anlegen: bd's eingebetteter Dolt-Speicher, Beads mit Namen %@-<id>, keine Agent-Dateien und keine Git-Hooks.\n\nbd führt aus:\n%@\n\nbd committet den neuen Ordner .beads und einen .gitignore-Eintrag im Repository und rührt sonst nichts an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un repositorio Git sin base de datos .beads. Beady puede crear una: el almacenamiento Dolt integrado de bd, beads llamados %@-<id>, sin archivos de agentes ni hooks de Git.\n\nbd ejecutará:\n%@\n\nbd confirma la nueva carpeta .beads y una entrada en .gitignore en el repositorio, y no toca nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un dépôt Git sans base de données .beads. Beady peut en créer une : le stockage Dolt intégré de bd, des beads nommés %@-<id>, sans fichiers d'agents ni hooks Git.\n\nbd exécutera :\n%@\n\nbd valide (commit) le nouveau dossier .beads et une entrée .gitignore dans le dépôt, et ne touche à rien d'autre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は .beads データベースのない Git リポジトリです。Beady が作成できます：bd の組み込み Dolt ストレージ、%@-<id> という名前のビーズ、エージェント用ファイルも Git フックもなし。\n\nbd は次を実行します：\n%@\n\nbd は新しい .beads フォルダと .gitignore の項目をリポジトリにコミットし、それ以外には触れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) .beads 데이터베이스가 없는 Git 저장소입니다. Beady가 만들 수 있습니다: bd의 내장 Dolt 저장소, %@-<id> 이름의 비드, 에이전트 파일과 Git 훅 없음.\n\nbd가 실행할 명령:\n%@\n\nbd는 새 .beads 폴더와 .gitignore 항목을 저장소에 커밋하며 그 외에는 아무것도 건드리지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é um repositório Git sem banco de dados .beads. O Beady pode criar um: o armazenamento Dolt embutido do bd, beads chamados %@-<id>, sem arquivos de agentes nem hooks do Git.\n\nO bd executará:\n%@\n\nO bd faz commit da nova pasta .beads e de uma entrada no .gitignore no repositório, e não toca em mais nada."
          }
        }
      }
    },
    "%@ is set up as the place to share these beads, and nothing has been sent to it yet." : {
      "comment" : "The remote's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist als Ort zum Teilen dieser Beads eingerichtet, und es wurde noch nichts dorthin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está configurado como el lugar para compartir estos beads, y todavía no se le ha enviado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est configuré comme l'endroit où partager ces beads, et rien n'y a encore été envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はこれらのビーズの共有先として設定されていますが、まだ何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이 비즈를 공유할 곳으로 설정되어 있지만 아직 아무것도 보내지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está configurado como o lugar para compartilhar estes beads, e nada foi enviado para lá ainda."
          }
        }
      }
    },
    "%@ is set up for beads, and bd found no database here, on a remote or in a backup, so it would start an empty one.\n\nIf these beads already exist on another Mac, share them from there first and open this folder again: a database started here would be a separate backlog." : {
      "comment" : "Alert text; the folder's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist für Beads eingerichtet, und bd hat weder hier noch auf einem Remote oder in einem Backup eine Datenbank gefunden, würde also eine leere anlegen.\n\nWenn diese Beads bereits auf einem anderen Mac existieren, teile sie zuerst von dort und öffne diesen Ordner erneut: Eine hier angelegte Datenbank wäre ein eigenes, getrenntes Backlog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está configurado para beads, y bd no encontró ninguna base de datos aquí, en un remoto ni en una copia de seguridad, así que crearía una vacía.\n\nSi estos beads ya existen en otro Mac, compártelos primero desde allí y vuelve a abrir esta carpeta: una base de datos creada aquí sería un backlog aparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est configuré pour beads, et bd n'a trouvé aucune base de données ici, sur un dépôt distant ou dans une sauvegarde ; il en créerait donc une vide.\n\nSi ces beads existent déjà sur un autre Mac, partagez-les d'abord depuis celui-ci puis rouvrez ce dossier : une base de données créée ici serait un backlog distinct."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はビーズ用に設定されていますが、bdはここにも、リモートにも、バックアップにもデータベースを見つけられなかったため、空のデータベースを作成します。\n\nこれらのビーズがすでに別のMacにある場合は、先にそのMacから共有してから、このフォルダを開き直してください。ここで作成したデータベースは別個のバックログになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 비즈용으로 설정되어 있지만, bd가 여기에서도 리모트에서도 백업에서도 데이터베이스를 찾지 못했으므로 빈 데이터베이스를 새로 만들게 됩니다.\n\n이 비즈가 이미 다른 Mac에 있다면 먼저 그 Mac에서 공유한 다음 이 폴더를 다시 여세요. 여기서 만든 데이터베이스는 별개의 백로그가 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está configurado para beads, e o bd não encontrou nenhum banco de dados aqui, em um remoto nem em um backup; por isso criaria um vazio.\n\nSe estes beads já existem em outro Mac, compartilhe-os de lá primeiro e abra esta pasta de novo: um banco de dados criado aqui seria um backlog separado."
          }
        }
      }
    },
    "%@ is set up for beads, and this copy doesn't have the database yet." : {
      "comment" : "Alert text; the folder's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist für Beads eingerichtet, und diese Kopie hat die Datenbank noch nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está configurado para beads, y esta copia todavía no tiene la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est configuré pour beads, et cette copie n'a pas encore la base de données."
