    "↑↓ to try them on. Appearance follows macOS, so your dark and light choices are both used — each when macOS switches to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ zum Anprobieren. Das Erscheinungsbild folgt macOS, daher werden deine dunkle und deine helle Wahl beide verwendet — jeweils, wenn macOS dorthin wechselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ para probarlos. El aspecto sigue a macOS, así que se usan tanto tu elección oscura como la clara, cada una cuando macOS cambia a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ pour les essayer. L'apparence suit macOS : vos choix sombre et clair sont donc tous deux utilisés, chacun quand macOS y passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓で試せます。外観はmacOSに従うため、ダークとライトの選択はどちらも使われ、macOSが切り替わるたびにそれぞれ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓로 미리 적용해 볼 수 있습니다. 화면 모드가 macOS를 따르므로 다크와 라이트 선택이 모두 쓰이며, macOS가 전환될 때마다 각각 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ para experimentar. A Aparência segue o macOS, então suas escolhas escura e clara são usadas — cada uma quando o macOS muda para ela."
          }
        }
      }
    },
    "↑↓ to try them on. Appearance is pinned to Dark, so the dark choice is what you'll see." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ zum Anprobieren. Das Erscheinungsbild ist auf „Dunkel“ festgelegt, daher siehst du die dunkle Wahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ para probarlos. El aspecto está fijado en Oscuro, así que verás la elección oscura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ pour les essayer. L'apparence est fixée sur Sombre : c'est donc le choix sombre que vous verrez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓で試せます。外観はダークに固定されているため、表示されるのはダークの選択です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓로 미리 적용해 볼 수 있습니다. 화면 모드가 다크로 고정되어 있어 다크 선택이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ para experimentar. A Aparência está fixa em Escuro, então você verá a escolha escura."
          }
        }
      }
    },
    "↑↓ to try them on. Appearance is pinned to Light, so the light choice is what you'll see." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ zum Anprobieren. Das Erscheinungsbild ist auf „Hell“ festgelegt, daher siehst du die helle Wahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ para probarlos. El aspecto está fijado en Claro, así que verás la elección clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ pour les essayer. L'apparence est fixée sur Clair : c'est donc le choix clair que vous verrez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓で試せます。外観はライトに固定されているため、表示されるのはライトの選択です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓로 미리 적용해 볼 수 있습니다. 화면 모드가 라이트로 고정되어 있어 라이트 선택이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ para experimentar. A Aparência está fixa em Claro, então você verá a escolha clara."
          }
        }
      }
    },
    "⌘P opens the command palette, where everything else lives." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘P öffnet die Befehlspalette, in der alles Weitere steckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘P abre la paleta de comandos, donde está todo lo demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘P ouvre la palette de commandes, où se trouve tout le reste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Pでコマンドパレットが開きます。そのほかの操作はすべてそこにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘P로 명령 팔레트를 열면 나머지 모든 기능을 찾을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘P abre a paleta de comandos, onde está todo o resto."
          }
        }
      }
    }
  },
  "version" : "1.0"
