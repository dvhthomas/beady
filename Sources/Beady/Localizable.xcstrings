        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Predeterminado del sistema» sigue a macOS. Es la misma elección por app que en Ajustes del Sistema › General › Idioma y región › Apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
