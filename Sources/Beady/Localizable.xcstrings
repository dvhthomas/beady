    "Everything here lands in one %@ column, and no other grouping would spread it out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles hier landet in einer einzigen Spalte „%@“, und keine andere Gruppierung würde es verteilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo de aquí cae en una sola columna de %@, y ninguna otra agrupación lo repartiría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ici tombe dans une seule colonne %@, et aucun autre regroupement ne l'étalerait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにあるものはすべて1つの%@列に入り、他のグループ化でも分かれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 있는 모든 항목이 %@ 열 하나에 들어가며, 다른 그룹화로도 나뉘지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo aqui cai em uma só coluna de %@, e nenhum outro agrupamento espalharia os beads."
          }
        }
      }
    },
    "Everything here lands in one %@ column. Group by something that would spread it out, or show the list:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles hier landet in einer einzigen Spalte „%@“. Gruppiere nach etwas, das es verteilt, oder zeig die Liste:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo de aquí cae en una sola columna de %@. Agrupa por algo que lo reparta, o muestra la lista:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ici tombe dans une seule colonne %@. Regroupez par un critère qui l'étalerait, ou affichez la liste :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにあるものはすべて1つの%@列に入ります。分かれるようにグループ化するか、リストで表示してください："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 있는 모든 항목이 %@ 열 하나에 들어갑니다. 나뉠 수 있는 기준으로 그룹화하거나 목록으로 보세요:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo aqui cai em uma só coluna de %@. Agrupe por algo que espalhe os beads, ou mostre a lista:"
          }
        }
      }
    },
