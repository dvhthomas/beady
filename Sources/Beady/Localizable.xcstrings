    "%@ has changes it can't keep: save them as a new view, or reset" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat Änderungen, die nicht behalten werden können: Sichere sie als neue Ansicht oder setze zurück"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene cambios que no puede conservar: guárdalos como vista nueva o restablécela"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a des modifications qu'elle ne peut pas conserver : enregistrez-les comme nouvelle vue, ou réinitialisez"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には保持できない変更があります。新規ビューとして保存するか、リセットしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 보기에 유지할 수 없는 변경 사항이 있습니다. 새로운 보기로 저장하거나 재설정하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem alterações que não pode manter: salve-as como nova visualização ou redefina"
          }
        }
      }
    },
