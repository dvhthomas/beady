{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\nShown for context; doesn't match the filters" : {
      "comment" : "Tooltip on a dimmed tree row; the value is the bead's title",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nZum Kontext angezeigt; passt nicht zu den Filtern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSe muestra como contexto; no coincide con los filtros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nAffiché pour le contexte ; ne correspond pas aux filtres"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n文脈のために表示。フィルタには一致しません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n맥락을 위해 표시됨. 필터와 일치하지 않음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nMostrado para contexto; não corresponde aos filtros"
          }
        }
      }
    },
    "%@ %@\nClick to follow · Show in Main Window to open it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@\nKlicken zum Folgen · „Im Hauptfenster anzeigen“ zum Öffnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@\nClick to follow · Show in Main Window to open it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@\nHaz clic para seguirlo · «Mostrar en la ventana principal» para abrirlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@\nCliquez pour le suivre · Afficher dans la fenêtre principale pour l'ouvrir"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@\nクリックでたどる · 「メインウインドウで表示」で開く"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@\n클릭하여 따라가기 · 열려면 ‘메인 윈도우에서 보기’"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@\nClique para seguir · Mostrar na janela principal para abri-lo"
          }
        }
      }
    },
