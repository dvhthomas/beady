          }
        }
      }
    },
    "Its status was set to blocked. bd keeps no reason for that, and nothing upstream is recorded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Status wurde auf blocked gesetzt. bd speichert dafür keinen Grund, und nichts Vorgelagertes ist erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su estado se puso en blocked. bd no guarda ningún motivo, y no hay registrado nada que lo bloquee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son statut a été réglé sur blocked. bd n'en conserve pas le motif, et rien en amont n'est enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスがblockedに設定されています。bdはその理由を保存せず、上流の記録もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태가 blocked로 설정되었습니다. bd는 그 이유를 보관하지 않으며, 상위에 기록된 것도 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O status dele foi definido como blocked. O bd não guarda motivo para isso, e nenhuma dependência anterior está registrada."
          }
        }
      }
    },
    "Keeps this view's filters, layout, grouping and ordering under a name of its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält Filter, Layout, Gruppierung und Sortierung dieser Ansicht unter einem eigenen Namen."
          }
        },
