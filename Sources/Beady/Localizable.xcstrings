    "assignee" : {
      "comment" : "A field, in a list of what an edit will change\nHistory: a field name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeiter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "responsable"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "responsable"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "担当者"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "담당자"
          }
        },
        "pt-BR" : {
